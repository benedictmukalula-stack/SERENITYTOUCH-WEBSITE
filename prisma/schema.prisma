generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  price       Int
  duration    String
  durationMin Int
  description String
  benefits    String   @default("")
  image       String   @default("")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  addons      ServiceAddon[]
  bookings    Booking[]
}

model ServiceAddon {
  id          String  @id @default(cuid())
  name        String
  price       Int
  description String  @default("")
  icon        String  @default("")
  active      Boolean @default(true)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId   String
}

model Therapist {
  id        String   @id @default(cuid())
  name      String
  specialty String
  bio       String   @default("")
  image     String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  bookings     Booking[]
  availability  StaffAvailability[]
  createdAt DateTime @default(now())
}

model Member {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String    @default("")
  password  String
  tier      String    @default("Silver")
  points    Int       @default(0)
  active    Boolean   @default(true)
  bookings    Booking[]
  referrals   Referral[]
  loyaltyLogs LoyaltyLog[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Booking {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  name            String
  email           String
  phone           String   @default("")
  status          String   @default("confirmed")
  serviceName     String
  date            String
  time            String   @default("")
  bookingType     String   @default("in_spa")
  calloutZone     String   @default("")
  calloutAddress  String   @default("")
  addons          String   @default("[]")
  totalAmount     Int
  paymentMethod   String   @default("cash")
  paymentStatus   String   @default("pending")
  notes           String   @default("")
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  therapistId     String?
  therapist       Therapist? @relation(fields: [therapistId], references: [id])
  therapistName   String   @default("First Available")
  memberId        String?
  member          Member?  @relation(fields: [memberId], references: [id])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  content   String
  image     String   @default("")
  service   String   @default("")
  active    Boolean  @default(true)
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String   @default("")
  content   String   @default("")
  category  String   @default("Wellness")
  image     String   @default("")
  author    String   @default("Serenity Touch")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VoucherPurchase {
  id             String   @id @default(cuid())
  code           String   @unique
  amount         Int
  senderName     String
  senderEmail    String
  recipientName  String
  recipientEmail String
  message        String   @default("")
  status         String   @default("active")
  createdAt      DateTime @default(now())
  redemptions    VoucherRedemption[]
}

model Referral {
  id        String   @id @default(cuid())
  code      String   @unique
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  referredName  String   @default("")
  referredEmail String   @default("")
  status    String   @default("active")
  points    Int      @default(0)
  createdAt DateTime @default(now())
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("admin") // admin, receptionist, therapist, manager
  active    Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromoLog {
  id          String   @id @default(cuid())
  message     String
  filter      String   @default("all")
  sentCount   Int      @default(0)
  failCount   Int      @default(0)
  sentBy     String   @default("")
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model StaffAvailability {
  id         String   @id @default(cuid())
  therapistId String
  therapist  Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  dayOfWeek  Int      // 0=Sun, 1=Mon...6=Sat
  startTime  String   // "09:00" (24h)
  endTime    String   // "17:00" (24h)
  available  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([therapistId, dayOfWeek])
}

model LoyaltyLog {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bookingId   String?
  points      Int      // positive=earn, negative=redeem
  reason      String   // "booking_completed", "referral_bonus", "redeemed", "manual_adjust"
  description String   @default("")
  createdById String?
  createdAt   DateTime @default(now())
}

model VoucherRedemption {
  id            String          @id @default(cuid())
  voucherId     String
  voucher       VoucherPurchase @relation(fields: [voucherId], references: [id])
  bookingId     String?
  redeemedByName  String
  redeemedByPhone String @default("")
  discountAmount  Int
  createdBy      String   @default("")
  createdAt      DateTime @default(now())
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  message     String
  filter      String   @default("all")
  audience    String   @default("all")
  status      String   @default("draft") // draft, scheduled, sent, failed
  sentCount   Int      @default(0)
  failCount   Int      @default(0)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdBy   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        PromoLog[]
}

model PointsConfig {
  id             String @id @default(cuid())
  key            String @unique
  value          Int    @default(0)
  description    String @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}