generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  price       Int
  duration    String
  durationMin Int
  description String
  benefits    String   @default("")
  image       String   @default("")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  addons      ServiceAddon[]
  bookings    Booking[]
}

model ServiceAddon {
  id          String  @id @default(cuid())
  name        String
  price       Int
  description String  @default("")
  icon        String  @default("")
  active      Boolean @default(true)
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId   String
}

model Therapist {
  id        String   @id @default(cuid())
  name      String
  specialty String
  bio       String   @default("")
  image     String   @default("")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  bookings  Booking[]
  createdAt DateTime @default(now())
}

model Member {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  phone     String    @default("")
  password  String
  tier      String    @default("Silver")
  points    Int       @default(0)
  active    Boolean   @default(true)
  bookings  Booking[]
  referrals Referral[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Booking {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  name            String
  email           String
  phone           String   @default("")
  status          String   @default("confirmed")
  serviceName     String
  date            String
  time            String   @default("")
  bookingType     String   @default("in_spa")
  calloutZone     String   @default("")
  calloutAddress  String   @default("")
  addons          String   @default("[]")
  totalAmount     Int
  paymentMethod   String   @default("cash")
  paymentStatus   String   @default("pending")
  notes           String   @default("")
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  serviceId       String
  service         Service  @relation(fields: [serviceId], references: [id])
  therapistId     String?
  therapist       Therapist? @relation(fields: [therapistId], references: [id])
  therapistName   String   @default("First Available")
  memberId        String?
  member          Member?  @relation(fields: [memberId], references: [id])
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  content   String
  image     String   @default("")
  service   String   @default("")
  active    Boolean  @default(true)
  featured  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String   @default("")
  content   String   @default("")
  category  String   @default("Wellness")
  image     String   @default("")
  author    String   @default("Serenity Touch")
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VoucherPurchase {
  id        String   @id @default(cuid())
  code      String   @unique
  amount    Int
  senderName  String
  senderEmail String
  recipientName String
  recipientEmail String
  message   String   @default("")
  status    String   @default("active")
  createdAt DateTime @default(now())
}

model Referral {
  id        String   @id @default(cuid())
  code      String   @unique
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  referredName  String   @default("")
  referredEmail String   @default("")
  status    String   @default("active")
  points    Int      @default(0)
  createdAt DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}